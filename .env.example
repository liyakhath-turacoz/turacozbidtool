TURACOZ_DB_HOST=127.0.0.1
TURACOZ_DB_PORT=3306
TURACOZ_DB_USER=turacoz_app
TURACOZ_DB_PASSWORD=replace-with-a-local-database-password
TURACOZ_DB_NAME=turacoz_bidtool
TURACOZ_JWT_SECRET=generate-a-unique-long-random-secret
TURACOZ_ADMIN_PASSWORD=choose-a-local-admin-password-before-first-seed
TURACOZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5180,http://127.0.0.1:5180
TURACOZ_IMPORT_PRODUCTS_ON_STARTUP=true
